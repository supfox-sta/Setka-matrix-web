html[data-setka-client="true"] .mx_RoomListPanel {
    display: flex;
    flex-direction: column;
    min-height: 0;
    height: 100%;
    overflow: hidden;
    background: transparent !important;
    background-color: transparent !important;
}

html[data-setka-client="true"] .mx_SetkaFeedPanel_header {
    background: transparent !important;
    background-color: transparent !important;
}

.mx_SetkaFeedPanel {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
}

.mx_SetkaFeedPanel_header {
    flex: 0 0 auto;
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--cpd-color-bg-canvas-default);
    border-bottom: 1px solid var(--cpd-color-border-subtle-primary);
}

.mx_SetkaFeedPanel_subTabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    padding: var(--cpd-space-2x) var(--cpd-space-4x) var(--cpd-space-3x);
}

.mx_SetkaFeedPanel_subTab {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 34px;
    min-width: 0;
    padding: 0 var(--cpd-space-1x);
    border-radius: 10px !important;
    background: var(--cpd-color-bg-subtle-secondary) !important;
    color: var(--cpd-color-text-secondary) !important;
    font: var(--cpd-font-body-md-semibold);
    text-align: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_SetkaFeedPanel_subTab_active {
    background: var(--cpd-color-bg-canvas-default) !important;
    color: var(--cpd-color-text-primary) !important;
    box-shadow: inset 0 0 0 1px var(--cpd-color-border-accent);
}

.mx_SetkaFeedPanel_list {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: var(--cpd-space-3x) var(--cpd-space-3x) var(--cpd-space-4x);
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
}

.mx_SetkaFeedPanel_centered {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--cpd-space-8x) var(--cpd-space-4x);
    color: var(--cpd-color-text-secondary);
    text-align: center;
}

.mx_SetkaFeedPanel_loadingMore {
    padding: var(--cpd-space-3x) 0;
}

.mx_SetkaFeedPanel_sentinel {
    width: 100%;
    height: 1px;
    flex: 0 0 auto;
}

.mx_SetkaFeedPanel_postCard,
.mx_SetkaFeedPanel_channelCard {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 16px;
    background: var(--cpd-color-bg-canvas-default);
    overflow: hidden;
}

.mx_SetkaFeedPanel_postMain {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
    width: 100%;
    box-sizing: border-box;
    padding: var(--cpd-space-3x);
    text-align: left;
}

.mx_SetkaFeedPanel_channelCard {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-3x);
    text-align: left;
}

.mx_SetkaFeedPanel_postHeader {
    display: flex;
    gap: var(--cpd-space-3x);
    align-items: center;
}

.mx_SetkaFeedPanel_postHeaderText,
.mx_SetkaFeedPanel_channelText {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1 1 auto;
}

.mx_SetkaFeedPanel_postChannel,
.mx_SetkaFeedPanel_channelName {
    font: var(--cpd-font-body-md-semibold);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_SetkaFeedPanel_postMeta,
.mx_SetkaFeedPanel_channelMeta {
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_SetkaFeedPanel_postBody {
    margin: 0;
    white-space: pre-wrap;
    font: var(--cpd-font-body-sm-regular);
    line-height: 1.45;
    word-break: break-word;
}

.mx_SetkaFeedPanel_postMedia {
    width: 100%;
    max-height: 360px;
    object-fit: contain;
    border-radius: 12px;
    background: var(--cpd-color-bg-subtle-secondary);
}

.mx_SetkaFeedPanel_postActions {
    display: flex;
    gap: var(--cpd-space-2x);
    padding: 0 var(--cpd-space-3x) var(--cpd-space-3x);
    flex-wrap: wrap;
}

.mx_SetkaFeedPanel_action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 999px;
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-xs-medium);
}

.mx_SetkaFeedPanel_action_active {
    color: var(--cpd-color-text-action-accent);
}

.mx_SetkaFeedVideoNote {
    display: flex;
    justify-content: center;
    padding: var(--cpd-space-2x) 0;
}

.mx_SetkaFeedVideoNote_shell {
    position: relative;
    width: 120px;
    height: 120px;
}

.mx_SetkaFeedVideoNote_playHit {
    position: absolute;
    inset: 6px;
    padding: 0;
    border: none;
    border-radius: 50%;
    overflow: hidden;
    background: #101010;
    cursor: pointer;
    z-index: 2;
}

.mx_SetkaFeedVideoNote_player,
.mx_SetkaFeedVideoNote_player video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    pointer-events: none;
}

.mx_SetkaFeedVideoNote_ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    pointer-events: none;
    z-index: 1;
}

.mx_SetkaFeedVideoNote_playIcon {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgb(0 0 0 / 45%);
}

.mx_SetkaFeedVideoNote_playIcon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 54%;
    transform: translate(-50%, -50%);
    border-style: solid;
    border-width: 8px 0 8px 12px;
    border-color: transparent transparent transparent #fff;
}
