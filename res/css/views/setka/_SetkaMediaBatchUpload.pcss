.mx_SetkaMediaBatchUploadDialog_hint {
    margin: 0 0 var(--cpd-space-3x);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_SetkaMediaBatchUploadDialog_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: var(--cpd-space-2x);
    margin-bottom: var(--cpd-space-4x);
}

.mx_SetkaMediaBatchUploadDialog_item {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-1x);
    min-width: 0;
}

.mx_SetkaMediaBatchUploadDialog_thumb {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
    background: var(--cpd-color-bg-subtle-secondary);
}

.mx_SetkaMediaBatchUploadDialog_meta {
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_SetkaCreateChannelDialog_content {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
}
