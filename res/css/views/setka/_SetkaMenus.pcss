/* Compound floating menus (UserMenu, room header, etc.) */
html[data-setka-client="true"] [role="menu"] {
    background: var(--setka-surface) !important;
    color: var(--setka-surface-text) !important;
    outline-color: var(--setka-surface-border) !important;
    border-radius: 18px !important;
    box-shadow: var(--setka-surface-shadow) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    --cpd-color-bg-canvas-default: transparent;
    --cpd-color-bg-action-secondary-rest: transparent;
    --cpd-color-bg-action-secondary-hovered: rgb(124 92 255 / 16%);
    --cpd-color-bg-action-secondary-pressed: rgb(124 92 255 / 22%);
    --cpd-color-text-primary: var(--setka-surface-text);
    --cpd-color-text-secondary: var(--setka-surface-text-secondary);
    --cpd-color-icon-primary: var(--setka-surface-text);
    --cpd-color-icon-secondary: var(--setka-surface-text-secondary);
    --cpd-color-text-critical-primary: rgb(255 160 160 / 96%);
    --cpd-color-icon-critical-primary: rgb(255 160 160 / 96%);
    --cpd-color-bg-critical-subtle: rgb(220 38 38 / 14%);
    --cpd-color-bg-critical-subtle-hovered: rgb(220 38 38 / 20%);
}

html[data-setka-client="true"] [role="menu"] [role="menuitem"],
html[data-setka-client="true"] [role="menu"] [role="menuitemcheckbox"],
html[data-setka-client="true"] [role="menu"] [role="menuitemradio"] {
    background: transparent !important;
    color: var(--setka-surface-text-secondary);
    border-radius: 10px;
    margin-inline: var(--cpd-space-2x);
    inline-size: calc(100% - var(--cpd-space-4x));
    min-inline-size: 0;
}

html[data-setka-client="true"] [role="menu"] [role="menuitem"] [class*="label"],
html[data-setka-client="true"] [role="menu"] [role="menuitemcheckbox"] [class*="label"],
html[data-setka-client="true"] [role="menu"] [role="menuitemradio"] [class*="label"] {
    color: inherit;
}

html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-kind="primary"] {
    color: var(--setka-surface-text);
}

html[data-setka-client="true"] [role="menu"] [role="menuitem"] [class*="icon"],
html[data-setka-client="true"] [role="menu"] [role="menuitemcheckbox"] [class*="icon"],
html[data-setka-client="true"] [role="menu"] [role="menuitemradio"] [class*="icon"] {
    color: var(--setka-surface-text-secondary);
}

html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-kind="primary"] [class*="icon"] {
    color: var(--setka-surface-text);
}

html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-kind="critical"],
html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-kind="critical"] [class*="label"],
html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-kind="critical"] [class*="icon"] {
    color: var(--cpd-color-text-critical-primary);
}

@media (hover) {
    html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-kind="primary"]:hover,
    html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-state]:hover,
    html[data-setka-client="true"] [role="menu"] [role="menuitemcheckbox"]:hover,
    html[data-setka-client="true"] [role="menu"] [role="menuitemradio"]:hover {
        background: var(--cpd-color-bg-action-secondary-hovered) !important;
    }

    html[data-setka-client="true"] [role="menu"] [role="menuitem"][data-kind="critical"]:hover {
        background: var(--cpd-color-bg-critical-subtle) !important;
    }
}

html[data-setka-client="true"] [role="menu"] [role="separator"],
html[data-setka-client="true"] [role="menu"] div[role="separator"] {
    background: var(--setka-surface-border) !important;
}

/* Inline menubars (room summary, right panel actions) */
html[data-setka-client="true"] [role="menubar"] {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-1x);
}

html[data-setka-client="true"] [role="menubar"] [role="menuitem"],
html[data-setka-client="true"] [role="menubar"] [role="menuitemcheckbox"],
html[data-setka-client="true"] [role="menubar"] [role="menuitemradio"] {
    background: transparent !important;
    color: var(--setka-surface-text-secondary);
    border-radius: 10px;
    margin-inline: var(--cpd-space-2x);
    inline-size: calc(100% - var(--cpd-space-4x));
    min-inline-size: 0;
    --cpd-color-bg-action-secondary-rest: transparent;
    --cpd-color-bg-action-secondary-hovered: rgb(124 92 255 / 16%);
    --cpd-color-text-primary: var(--setka-surface-text);
    --cpd-color-text-secondary: var(--setka-surface-text-secondary);
    --cpd-color-icon-primary: var(--setka-surface-text);
    --cpd-color-icon-secondary: var(--setka-surface-text-secondary);
}

html[data-setka-client="true"] [role="menubar"] [role="menuitem"][data-kind="primary"] {
    color: var(--setka-surface-text);
}

@media (hover) {
    html[data-setka-client="true"] [role="menubar"] [role="menuitem"][data-kind="primary"]:hover,
    html[data-setka-client="true"] [role="menubar"] [role="menuitemcheckbox"]:hover,
    html[data-setka-client="true"] [role="menubar"] [role="menuitemradio"]:hover {
        background: rgb(124 92 255 / 16%) !important;
    }
}

/* Legacy contextual / dropdown menus */
html[data-setka-client="true"] .mx_ContextualMenu {
    background: var(--setka-surface-solid) !important;
    color: var(--setka-surface-text) !important;
    border: 1px solid var(--setka-surface-border) !important;
    border-radius: 16px !important;
    box-shadow: var(--setka-surface-shadow) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
}

html[data-setka-client="true"] .mx_ContextualMenu_wrapper .mx_GenericDropdownMenu_Option--item:hover {
    background: rgb(124 92 255 / 16%) !important;
}

html[data-setka-client="true"] .mx_ContextualMenu_wrapper .mx_GenericDropdownMenu_Option--label span:first-child {
    color: var(--setka-surface-text);
}

html[data-setka-client="true"] .mx_GenericDropdownMenu_divider,
html[data-setka-client="true"] .mx_ContextualMenu_wrapper .mx_GenericDropdownMenu_divider {
    border-top-color: var(--setka-surface-border);
}

html[data-setka-client="true"] .mx_GenericDropdownMenu_button {
    color: var(--setka-surface-text-secondary);
    border-radius: 8px;
}

html[data-setka-client="true"] .mx_GenericDropdownMenu_button:hover,
html[data-setka-client="true"] .mx_GenericDropdownMenu_button[aria-expanded="true"] {
    background: rgb(255 255 255 / 12%);
    color: var(--setka-surface-text);
}

/* Widget / Element Call menu bar */
html[data-setka-client="true"] .mx_AppTileMenuBar {
    background: linear-gradient(155deg, rgb(34 24 68 / 0.88), rgb(22 14 48 / 0.84)) !important;
    color: rgb(255 255 255 / 94%);
    border-bottom: 1px solid rgb(255 255 255 / 12%) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

html[data-setka-client="true"] .mx_AppTileMenuBar_title,
html[data-setka-client="true"] .mx_AppTileMenuBar_title h1 {
    color: rgb(255 255 255 / 94%);
}

html[data-setka-client="true"] .mx_AppTileMenuBar_widgets_button .mx_Icon {
    color: rgb(255 255 255 / 68%) !important;
}

html[data-setka-client="true"] .mx_AppTileMenuBar_widgets_button:hover::after {
    background: rgb(255 255 255 / 14%) !important;
}

html[data-setka-client="true"][data-setka-theme-tone="light"] .mx_AppTileMenuBar {
    background: linear-gradient(155deg, rgb(255 255 255 / 0.9), rgb(244 238 255 / 0.86)) !important;
    color: rgb(28 20 48 / 94%);
    border-bottom-color: rgb(124 92 255 / 14%) !important;
}

html[data-setka-client="true"][data-setka-theme-tone="light"] .mx_AppTileMenuBar_title,
html[data-setka-client="true"][data-setka-theme-tone="light"] .mx_AppTileMenuBar_title h1 {
    color: rgb(28 20 48 / 94%);
}

html[data-setka-client="true"][data-setka-theme-tone="light"] .mx_AppTileMenuBar_widgets_button .mx_Icon {
    color: rgb(28 20 48 / 58%) !important;
}
