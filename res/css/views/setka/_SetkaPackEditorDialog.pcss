.mx_SetkaPackEditorDialog.mx_UserSettingsDialog {
    width: min(720px, calc(100vw - 32px));
    max-width: min(720px, calc(100vw - 32px));
}

.mx_SetkaPackEditorDialog_body {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
    padding: var(--cpd-space-2x) 0 var(--cpd-space-4x);
}

.mx_SetkaPackEditorDialog_hint,
.mx_SetkaPackEditorDialog_empty {
    margin: 0;
    padding: var(--cpd-space-4x);
    border-radius: var(--cpd-space-3x);
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    text-align: center;
}

.mx_SetkaPackEditorDialog_error {
    margin: 0;
    padding: var(--cpd-space-3x);
    border-radius: var(--cpd-space-2x);
    background: var(--cpd-color-bg-critical-subtle);
    color: var(--cpd-color-text-critical-primary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_SetkaPackEditorDialog_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
    gap: var(--cpd-space-3x);
    max-height: 360px;
    overflow-y: auto;
    padding: var(--cpd-space-1x);
}

.mx_SetkaPackEditorDialog_cell,
.mx_SetkaPackEditorDialog_addCell {
    position: relative;
    aspect-ratio: 1;
    border-radius: var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-subtle-primary);
    background: var(--cpd-color-bg-subtle-secondary);
    overflow: hidden;
}

.mx_SetkaPackEditorDialog_cell img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.mx_SetkaPackEditorDialog_cellDelete {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 24px;
    min-height: 24px;
    padding: 0;
    border-radius: 999px;
}

.mx_SetkaPackEditorDialog_addCell {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cpd-color-icon-secondary);
}

.mx_SetkaPackEditorDialog_fileInput {
    display: none;
}

.mx_SetkaPackEditorDialog_actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-3x);
    justify-content: flex-end;
}
