.mx_SetkaAppearanceSettings {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-5x);
}

.mx_SetkaAppearanceSettings_hint {
    margin: 0;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_SetkaAppearanceSettings_section {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
    padding: var(--cpd-space-4x);
    border-radius: var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-subtle-primary);
    background: var(--cpd-color-bg-subtle-secondary);
}

.mx_SetkaAppearanceSettings_sectionTitle {
    margin: 0;
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_SetkaAppearanceSettings_field {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    font: var(--cpd-font-body-sm-regular);
}

.mx_SetkaAppearanceSettings_toggle {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.mx_SetkaAppearanceSettings_field input[type="range"] {
    width: 100%;
}

.mx_SetkaAppearanceSettings_field input[type="range"]:disabled {
    opacity: 0.45;
}

.mx_SetkaAppearanceSettings_value {
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_SetkaAppearanceSettings_colorRow {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
}

.mx_SetkaAppearanceSettings_colorLabel {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-primary);
}

.mx_SetkaAppearanceSettings_presets {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);
}

.mx_SetkaAppearanceSettings_swatch {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 2px solid var(--cpd-color-border-subtle-primary);
    transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.mx_SetkaAppearanceSettings_swatch:hover {
    transform: scale(1.06);
}

.mx_SetkaAppearanceSettings_swatch_active {
    border-color: var(--cpd-color-border-accent);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--setka-accent-user, var(--cpd-color-bg-accent-rest)) 35%, transparent);
}
