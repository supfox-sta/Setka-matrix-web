.mx_SetkaSpaceNav_contextMenu.mx_IconizedContextMenu {

    min-width: 220px;

    padding: 8px;

    border-radius: 14px;

    background: var(--cpd-color-bg-canvas-default);

    box-shadow: 0 12px 40px rgb(0 0 0 / 18%);

}



.mx_SetkaSpaceNav_contextMenu .mx_SpacePanel_contextMenu_header {

    margin: 4px 12px 8px;

    font: var(--cpd-font-body-xs-semibold);

    color: var(--cpd-color-text-secondary);

    text-transform: uppercase;

    letter-spacing: 0.05em;

}



.mx_SetkaSpaceNav_contextMenu .mx_IconizedContextMenu_item {

    display: flex;

    align-items: center;

    gap: 12px;

    min-height: 40px;

    padding: 8px 12px;

    border-radius: 10px;

    font: var(--cpd-font-body-sm-medium);

    color: var(--cpd-color-text-primary);

}



.mx_SetkaSpaceNav_contextMenu .mx_IconizedContextMenu_item:hover,

.mx_SetkaSpaceNav_contextMenu .mx_IconizedContextMenu_item:focus-visible {

    background: var(--cpd-color-bg-subtle-secondary);

}



.mx_SetkaSpaceNav_contextMenu .mx_IconizedContextMenu_label {

    flex: 1 1 auto;

}



.mx_SetkaSpaceNavButton {

    transition: transform 160ms ease;

}



.mx_SetkaSpaceNavButton:active {

    transform: scale(0.95);

}


