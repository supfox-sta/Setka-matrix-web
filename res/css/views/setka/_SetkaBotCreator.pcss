.mx_SetkaBotStartComposer {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: var(--cpd-space-4x) var(--cpd-space-6x);
    border-top: 1px solid var(--cpd-color-bg-subtle-primary);
}

.mx_SetkaBotStartComposer_button {
    width: 100%;
    max-width: 320px;
    padding: var(--cpd-space-3x) var(--cpd-space-6x);
    border-radius: var(--cpd-radius-pill);
    font: var(--cpd-font-body-md-semibold);
    text-align: center;
}

.mx_SetkaBotCreatorDialog.mx_UserSettingsDialog {
    max-width: 560px;
}

.mx_SetkaBotCreatorDialog_body {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
    padding: var(--cpd-space-4x);
}

.mx_SetkaBotCreatorDialog_meta {
    margin: 0;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    word-break: break-all;
}

.mx_SetkaBotCreatorDialog_hint,
.mx_SetkaBotCreatorDialog_success {
    margin: 0;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_SetkaBotCreatorDialog_error {
    margin: 0;
    color: var(--cpd-color-text-critical-primary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_SetkaBotCreatorDialog_token {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-3x);
    border-radius: 12px;
    background: var(--cpd-color-bg-subtle-secondary);
    word-break: break-all;
}

.mx_SetkaBotCreatorDialog_tokenLabel {
    font: var(--cpd-font-body-sm-semibold);
}

.mx_SetkaBotCreatorDialog_actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--cpd-space-3x);
}

.mx_SetkaBotCreatorSettings {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
}

.mx_SetkaBotCreatorSettings_header {
    display: flex;
    gap: var(--cpd-space-3x);
    align-items: flex-start;
}

.mx_SetkaBotCreatorSettings_headerIcon {
    flex: 0 0 auto;
    color: var(--cpd-color-icon-accent-primary);
}

.mx_SetkaBotCreatorSettings_title {
    margin: 0;
    font: var(--cpd-font-heading-sm-semibold);
}

.mx_SetkaBotCreatorSettings_subtitle {
    margin: var(--cpd-space-1x) 0 0;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-md-regular);
}

.mx_SetkaBotCreatorSettings_actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);
    justify-content: flex-start;
}

.mx_SetkaBotCreatorSettings_chatHint {
    margin: 0;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_SetkaBotCreatorSettings_loading {
    display: flex;
    justify-content: center;
    padding: var(--cpd-space-6x);
}

.mx_SetkaBotCreatorSettings_empty,
.mx_SetkaBotCreatorSettings_error {
    margin: 0;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-md-regular);
}

.mx_SetkaBotCreatorSettings_error {
    color: var(--cpd-color-text-critical-primary);
}

.mx_SetkaBotCreatorSettings_list {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
}

.mx_SetkaBotCreatorSettings_card {
    display: flex;
    gap: var(--cpd-space-3x);
    align-items: flex-start;
    justify-content: space-between;
    padding: var(--cpd-space-4x);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 16px;
    background: var(--cpd-color-bg-canvas-default);
}

.mx_SetkaBotCreatorSettings_cardText {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-1x);
    min-width: 0;
}

.mx_SetkaBotCreatorSettings_cardTitle {
    font: var(--cpd-font-body-lg-semibold);
}

.mx_SetkaBotCreatorSettings_cardMeta,
.mx_SetkaBotCreatorSettings_cardWebhook {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
    word-break: break-all;
}

.mx_SetkaBotCreatorSettings_cardButtons {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    gap: var(--cpd-space-2x);
}
