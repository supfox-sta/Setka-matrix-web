.mx_SetkaDmProfileSection {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
    padding: 0 var(--cpd-space-4x);
    box-sizing: border-box;
}

.mx_SetkaDmProfileSection_hero {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    min-height: 168px;
}

.mx_SetkaDmProfileSection_heroContent {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--cpd-space-4x);
    padding: var(--cpd-space-4x);
    text-align: left;
    width: 100%;
    box-sizing: border-box;
}

.mx_SetkaDmProfileSection_heroText {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    flex: 1 1 auto;
    min-width: 0;
}

.mx_SetkaDmProfileSection_nameRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    justify-content: flex-start;
}

.mx_SetkaDmProfileSection_name {
    margin: 0;
    font: var(--cpd-font-heading-md-semibold);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_SetkaDmProfileSection_badge,
.mx_SetkaDmProfileSection_status {
    width: 22px;
    height: 22px;
    object-fit: contain;
    flex: 0 0 auto;
}

.mx_SetkaDmProfileSection_bio {
    margin: 0;
    font: var(--cpd-font-body-sm-regular);
    white-space: pre-wrap;
    opacity: 0.92;
    line-height: 1.45;
}

.mx_SetkaDmProfileSection_info {
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 14px;
    padding: var(--cpd-space-3x) var(--cpd-space-4x);
    background: var(--cpd-color-bg-subtle-secondary);
    min-width: 0;
    overflow: hidden;
    box-sizing: border-box;
}

.mx_SetkaDmProfileSection_infoRow {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-1x);
    min-width: 0;
    width: 100%;
}

.mx_SetkaDmProfileSection_infoRow .mx_CopyableText {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

.mx_SetkaDmProfileSection_infoRow .mx_CopyableText.mx_CopyableText_border {
    width: 100%;
    max-width: 100%;
    margin: 0;
    word-break: break-all;
    overflow-wrap: anywhere;
}

.mx_SetkaDmProfileSection_infoLabel {
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
}

html[data-setka-client="true"] .mx_RoomSummaryCard_setkaDm {
    --cpd-separator-inset: var(--cpd-space-4x);
}

html[data-setka-client="true"] .mx_RoomSummaryCard_setkaDm [role="menubar"] {
    padding: 0 var(--cpd-space-2x) var(--cpd-space-3x);
}

@media (max-width: 480px) {
    .mx_SetkaDmProfileSection {
        padding: 0 var(--cpd-space-3x);
    }

    .mx_SetkaDmProfileSection_heroContent {
        flex-direction: column;
        text-align: center;
    }

    .mx_SetkaDmProfileSection_nameRow {
        justify-content: center;
    }
}

html[data-setka-client="true"] .mx_UserInfo_setka.mx_BaseCard {
    padding-top: 0;
}

html[data-setka-client="true"] .mx_UserInfo_setka .mx_AutoHideScrollbar {
    padding-top: var(--cpd-space-3x);
}

html[data-setka-client="true"] .mx_UserInfo_setka .mx_SetkaUserProfileSection {
    padding: 0 var(--cpd-space-3x);
    margin-bottom: var(--cpd-space-2x);
}
