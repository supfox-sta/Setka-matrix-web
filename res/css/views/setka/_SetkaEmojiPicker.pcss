.mx_SetkaEmojiPickerField {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
}

.mx_SetkaEmojiPickerField_label {
    font: var(--cpd-font-body-sm-medium);
    color: var(--cpd-color-text-primary);
}

.mx_SetkaEmojiPickerField_row {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    flex-wrap: wrap;
}

.mx_SetkaEmojiPickerField_preview {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-subtle-secondary);
    cursor: pointer;
    padding: 6px;
}

.mx_SetkaEmojiPickerField_preview img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.mx_SetkaEmojiPickerField_placeholder {
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
    text-align: center;
}

.mx_SetkaEmojiPickerDialog .mx_Dialog_content {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-4x);
    min-width: min(420px, 90vw);
}

.mx_SetkaEmojiPicker_loading,
.mx_SetkaEmojiPicker_empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 120px;
    color: var(--cpd-color-text-secondary);
}

.mx_SetkaEmojiPicker_packs {
    display: flex;
    gap: var(--cpd-space-2x);
    overflow-x: auto;
}

.mx_SetkaEmojiPicker_packTab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    background: var(--cpd-color-bg-subtle-secondary);
    flex: 0 0 auto;
}

.mx_SetkaEmojiPicker_packTab img {
    width: 24px;
    height: 24px;
    object-fit: contain;
}

.mx_SetkaEmojiPicker_packTab_active {
    border-color: var(--cpd-color-border-accent);
    background: var(--cpd-color-bg-canvas-default);
}

.mx_SetkaEmojiPicker_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: var(--cpd-space-2x);
    max-height: 280px;
    overflow-y: auto;
}

.mx_SetkaEmojiPicker_sticker {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    border: 1px solid transparent;
    background: var(--cpd-color-bg-subtle-secondary);
    padding: 6px;
}

.mx_SetkaEmojiPicker_sticker img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.mx_SetkaEmojiPicker_sticker_selected {
    border-color: var(--cpd-color-border-accent);
    box-shadow: 0 0 0 1px var(--cpd-color-border-accent);
}

.mx_SetkaEmojiPicker_actions {
    display: flex;
    justify-content: flex-end;
}
