.mx_SetkaAboutSettings {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-5x);
}

.mx_SetkaAboutSettings_header {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-4x);
    padding: var(--cpd-space-4x);
    border-radius: var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-subtle-primary);
    background: var(--cpd-color-bg-subtle-secondary);
}

.mx_SetkaAboutSettings_headerIcon {
    width: 40px;
    height: 40px;
    color: var(--setka-accent-user, var(--cpd-color-bg-accent-rest));
    flex-shrink: 0;
}

.mx_SetkaAboutSettings_appName {
    margin: 0;
    font: var(--cpd-font-heading-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_SetkaAboutSettings_version {
    margin: var(--cpd-space-1x) 0 0;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_SetkaAboutSettings_cards {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
}

.mx_SetkaAboutSettings_card {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-3x);
    border-radius: var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-subtle-primary);
    background: var(--cpd-color-bg-canvas-default);
}

.mx_SetkaAboutSettings_cardIcon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mx_SetkaAboutSettings_cardIcon_telegram {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    font: var(--cpd-font-body-sm-semibold);
    color: #fff;
    background: linear-gradient(145deg, #2aabee, #229ed9);
}

.mx_SetkaAboutSettings_cardText {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.mx_SetkaAboutSettings_cardTitle {
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_SetkaAboutSettings_cardSubtitle,
.mx_SetkaAboutSettings_cardMeta {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
