.mx_SetkaVideoNote {

    display: flex;

    justify-content: flex-start;

    padding: 4px 0;

}



.mx_SetkaVideoNote_shell {

    position: relative;

    width: 180px;

    height: 180px;

    flex: 0 0 auto;

}



.mx_SetkaVideoNote_ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    pointer-events: none;
    touch-action: none;
    z-index: 1;
}

.mx_SetkaVideoNote_ringHit {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
}



.mx_SetkaVideoNote_playHit {
    position: absolute;
    inset: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    overflow: hidden;
    background: #101010;
    cursor: pointer;
    z-index: 4;
    pointer-events: auto;
}

.mx_SetkaVideoNote_player,

.mx_SetkaVideoNote_player video {

    width: 100%;

    height: 100%;

    object-fit: cover;

    border-radius: 50%;

    pointer-events: none;

}



.mx_SetkaVideoNote_player::-webkit-media-controls,

.mx_SetkaVideoNote_player::-webkit-media-controls-enclosure {

    display: none !important;

}



.mx_SetkaVideoNote_playIcon {

    position: absolute;

    inset: 0;

    margin: auto;

    width: 44px;

    height: 44px;

    border-radius: 50%;

    background: rgb(0 0 0 / 45%);

}



.mx_SetkaVideoNote_playIcon::after {

    content: "";

    position: absolute;

    top: 50%;

    left: 54%;

    transform: translate(-50%, -50%);

    border-style: solid;

    border-width: 10px 0 10px 16px;

    border-color: transparent transparent transparent #fff;

}



.mx_SetkaVideoNote_ringTrack {

    fill: none;

    stroke: rgb(255 255 255 / 18%);

    stroke-width: 4;

}



.mx_SetkaVideoNote_ringProgress {

    fill: none;

    stroke: var(--cpd-color-border-accent);

    stroke-width: 4;

    stroke-linecap: round;

    transition: stroke-dashoffset 80ms linear;

}



.mx_SetkaVideoNote_duration {

    position: absolute;

    right: -4px;

    bottom: 4px;

    padding: 2px 8px;

    border-radius: 999px;

    background: rgb(0 0 0 / 55%);

    color: #fff;

    font: var(--cpd-font-body-xs-semibold);

    pointer-events: none;

}



.mx_SetkaVideoNoteDialog_wrapper .mx_Dialog {

    max-width: none;

    width: 100vw;

    height: 100vh;

    margin: 0;

    border-radius: 0;

    background: rgb(0 0 0 / 72%);

    box-shadow: none;

}



.mx_SetkaVideoNoteDialog_wrapper .mx_Dialog_title {

    display: none;

}



.mx_SetkaVideoNoteDialog_wrapper .mx_Dialog_cancel {

    color: #fff;

}



.mx_SetkaVideoNoteDialog {

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;

    gap: var(--cpd-space-5x);

    min-height: min(80vh, 640px);

    padding: var(--cpd-space-4x);

}



.mx_SetkaVideoNoteDialog_circle {

    position: relative;

    width: min(72vw, 280px);

    height: min(72vw, 280px);

    border-radius: 50%;

    overflow: hidden;

    background: #000;

    box-shadow:

        0 0 0 4px color-mix(in srgb, var(--cpd-color-border-accent) 80%, transparent),

        0 12px 40px rgb(0 0 0 / 35%);

}



.mx_SetkaVideoNoteDialog_video {

    width: 100%;

    height: 100%;

    object-fit: cover;

    transform: scaleX(-1);

}



.mx_SetkaVideoNoteDialog_video::-webkit-media-controls,

.mx_SetkaVideoNoteDialog_video::-webkit-media-controls-enclosure {

    display: none !important;

}



.mx_SetkaVideoNoteDialog_timer {

    position: absolute;

    bottom: 12px;

    left: 50%;

    transform: translateX(-50%);

    padding: 4px 10px;

    border-radius: 999px;

    background: rgb(0 0 0 / 55%);

    color: #fff;

    font: var(--cpd-font-body-sm-semibold);

}



.mx_SetkaVideoNoteDialog_error {

    margin: 0;

    color: var(--cpd-color-text-critical-primary);

    text-align: center;

    font: var(--cpd-font-body-sm-regular);

}



.mx_SetkaVideoNoteDialog_actions {

    display: flex;

    gap: var(--cpd-space-3x);

    justify-content: center;

    width: 100%;

}



html[data-setka-client="true"] .mx_EventTile_leftAlignedBubble .mx_SetkaVideoNote {
    padding-left: 0;
}



html[data-setka-client="true"] .mx_EventTile[data-self="true"] .mx_SetkaVideoNote {

    justify-content: flex-end;

}


