.mx_SetkaLeftPanelLogo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--cpd-space-3x) var(--cpd-space-4x) var(--cpd-space-2x);
}

.mx_SetkaLeftPanelLogo_button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border: none;
    border-radius: 14px;
    background: transparent;
    cursor: pointer;
    transition: transform 160ms ease, background 160ms ease, box-shadow 160ms ease;
}

.mx_SetkaLeftPanelLogo_button:hover {
    background: var(--cpd-color-bg-subtle-secondary);
}

.mx_SetkaLeftPanelLogo_button:active {
    transform: scale(0.97);
}

.mx_SetkaLeftPanelLogo_image {
    display: block;
    height: 28px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
}

/* Setka glass left panel: visible logo chip */
html[data-setka-client="true"] .mx_SetkaLeftPanelLogo_button {
    background: rgb(255 255 255 / 22%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 12%);
}

html[data-setka-client="true"][data-setka-theme-tone="light"] .mx_SetkaLeftPanelLogo_button {
    background: rgb(124 92 255 / 14%);
    box-shadow: inset 0 0 0 1px rgb(124 92 255 / 16%);
}

html[data-setka-client="true"] .mx_SetkaLeftPanelLogo_button:hover {
    background: rgb(255 255 255 / 28%);
}

html[data-setka-client="true"] .mx_SetkaLeftPanelLogo_button:active,
html[data-setka-client="true"] .mx_SetkaLeftPanelLogo_button:focus-visible {
    background: rgb(220 38 38 / 88%);
    box-shadow:
        inset 0 0 0 1px rgb(255 255 255 / 18%),
        0 4px 14px rgb(220 38 38 / 28%);
}

html[data-setka-client="true"] .mx_SetkaLeftPanelLogo_button:active .mx_SetkaLeftPanelLogo_image,
html[data-setka-client="true"] .mx_SetkaLeftPanelLogo_button:focus-visible .mx_SetkaLeftPanelLogo_image {
    filter: brightness(0) invert(1);
}

/* ===== PiP player in the left panel (replaces the logo) ===== */
html[data-setka-client="true"] .mx_SetkaLeftPanelLogo_pip {
    display: block;
    padding: var(--cpd-space-2x) var(--cpd-space-3x) 0;
}

html[data-setka-client="true"] .mx_SetkaPip {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px 10px 8px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 16%);
    border-radius: 18px;
    background:
        linear-gradient(135deg, color-mix(in srgb, var(--setka-accent-user, #7c5cff) 26%, transparent), transparent 70%),
        var(--setka-interface-solid, rgb(30 24 60 / 85%));
    box-shadow: 0 8px 24px rgb(0 0 0 / 28%), 0 1px 0 rgb(255 255 255 / 10%) inset;
    color: rgb(255 255 255 / 94%);
    animation: mx_SetkaMiniPlayerIn 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

html[data-setka-client="true"] .mx_SetkaPip button {
    appearance: none;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
}

html[data-setka-client="true"] .mx_SetkaPip_row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_play {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--setka-accent-user, #7c5cff);
    color: #fff;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--setka-accent-user, #7c5cff) 45%, transparent);
    transition: transform 120ms ease, filter 120ms ease;
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_play:hover {
    filter: brightness(1.12);
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_play:active {
    transform: scale(0.93);
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_info {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    text-align: start;
}

html[data-setka-client="true"] .mx_SetkaPip_title,
html[data-setka-client="true"] .mx_SetkaPip_sub {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

html[data-setka-client="true"] .mx_SetkaPip_title {
    font: var(--cpd-font-body-sm-semibold);
}

html[data-setka-client="true"] .mx_SetkaPip_sub {
    font: var(--cpd-font-body-xs-regular);
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 62%);
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_close {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: rgb(255 255 255 / 70%);
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_close:hover {
    background: rgb(255 255 255 / 14%);
    color: #fff;
}

html[data-setka-client="true"] .mx_SetkaPip_bar {
    height: 4px;
    margin: 0 2px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 18%);
    cursor: pointer;
}

html[data-setka-client="true"] .mx_SetkaPip_barFill {
    height: 100%;
    border-radius: inherit;
    background: var(--setka-accent-user, #7c5cff);
}

html[data-setka-client="true"] .mx_SetkaPip_list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 220px;
    overflow-y: auto;
    padding-top: 6px;
    border-top: 1px solid rgb(255 255 255 / 10%);
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px;
    border-radius: 10px;
    text-align: start;
    font: var(--cpd-font-body-xs-regular);
    color: rgb(255 255 255 / 82%);
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_item:hover {
    background: rgb(255 255 255 / 10%);
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_item_active {
    background: color-mix(in srgb, var(--setka-accent-user, #7c5cff) 30%, transparent);
    color: #fff;
}

html[data-setka-client="true"] .mx_SetkaPip_itemNum {
    flex: none;
    min-width: 16px;
    color: rgb(255 255 255 / 50%);
    font-variant-numeric: tabular-nums;
    text-align: center;
}

html[data-setka-client="true"] .mx_SetkaPip_itemText {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_goto {
    margin-top: 4px;
    padding: 8px 10px;
    border-radius: 10px;
    background: rgb(255 255 255 / 10%);
    font: var(--cpd-font-body-sm-medium);
    text-align: center;
}

html[data-setka-client="true"] .mx_SetkaPip button.mx_SetkaPip_goto:hover {
    background: rgb(255 255 255 / 18%);
}

html[data-setka-client="true"] .mx_SetkaPip_volume {
    width: 100%;
    margin: 0;
    accent-color: var(--setka-accent-user, #7c5cff);
}

html[data-setka-client="true"] .mx_SetkaPip_unused {
}
