html[data-setka-client="true"] .mx_LocationShareMenu {
    width: min(375px, calc(100vw - 32px));
    max-width: calc(100vw - 32px);
    height: min(460px, calc(100vh - 120px));
    max-height: calc(100vh - 120px);
    box-sizing: border-box;
    overflow: hidden;
}

html[data-setka-client="true"] .mx_LocationShareMenu .mx_LocationPicker,
html[data-setka-client="true"] .mx_LocationShareMenu .mx_EnableLiveShare {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
}

html[data-setka-client="true"] .mx_LocationShareMenu .mx_ShareDialogButtons {
    flex: 0 0 auto;
    box-sizing: border-box;
    padding: var(--cpd-space-2x) var(--cpd-space-3x) var(--cpd-space-3x);
}
